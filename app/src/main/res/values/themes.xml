<resources>
    <style name="Theme.GitDrop" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GitDrop.Main</item>
    </style>

    <style name="Theme.GitDrop.Main" parent="android:Theme.Material.Light.NoActionBar">
        <!-- White background so no red flashes through during Compose nav transitions -->
        <item name="android:windowBackground">#FFFBF8F7</item>
    </style>
</resources>
